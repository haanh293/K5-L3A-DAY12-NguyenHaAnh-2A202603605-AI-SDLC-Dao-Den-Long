{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:headless && vite build",
    "build:headless": "tsc -p tsconfig.headless.json",
    "preview": "node scripts/run-app.mjs",
    "bench": "node scripts/bench.mjs --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc scripts/soak.mjs --seed 7 --nights 10 --out soak.json",
    "test": "vitest run",
    "verify": "npm run build:headless && npm test && node scripts/verify-phase3.mjs && node --expose-gc scripts/soak.mjs --seed 7 --nights 10 --out soak.json"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
