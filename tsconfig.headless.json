{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist-headless",
    "rootDir": "src"
  },
  "include": ["src/core/**/*.ts", "src/headless/**/*.ts"]
}
